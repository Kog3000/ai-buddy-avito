# Скопируйте в .env и при необходимости заполните. Без LLM_API_KEY AI-buddy работает офлайн (retrieval по базе знаний).
SECRET_KEY=change-me
# Локально без Docker по умолчанию используется SQLite. В docker-compose — PostgreSQL.
# DATABASE_URL=postgresql+psycopg2://ai_buddy:ai_buddy@localhost:5432/ai_buddy

# LLM: любой OpenAI-совместимый Chat Completions API (OpenAI, OpenRouter, vLLM, локальная модель и т.п.)
LLM_PROVIDER=offline          # offline | openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT=25

# Через сколько секунд «политика» одобряет заявки на чтение (имитация сервиса доступов)
ACCESS_AUTO_APPROVE_SECONDS=8
# Токен, с которым внутренний ИИ-крон вызывает POST /api/cron/run
CRON_TOKEN=dev-cron-token
